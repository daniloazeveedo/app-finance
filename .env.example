# Conexão com o Postgres do Neon.
# A integração da Vercel com o Neon injeta esta variável sozinha no projeto.
# Localmente, copie a string de conexão do painel do Neon.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/caixa?sslmode=require"

# Dono dos dados enquanto não existe login.
# Qualquer texto estável serve. Quando a autenticação entrar, este valor
# vira o id do usuário autenticado e esta variável deixa de ser usada.
USUARIO_PADRAO="danilo"

# Opcional. Se preenchida, a API passa a exigir o cabeçalho x-chave com este valor.
# ATENÇÃO: isto NÃO é autenticação. O valor precisa ficar no config.js, que é
# público no site, então qualquer pessoa consegue lê-lo abrindo o código-fonte.
# Serve só para barrar varredura automática. Leia a seção "Segurança" do README.
CHAVE_APP=""

# Chave da API da Anthropic, usada apenas pela rota /api/agente.
# Nunca coloque este valor em nenhum arquivo dentro de public/.
ANTHROPIC_API_KEY=""
MODELO_AGENTE="claude-sonnet-5"

# Opcional. Domínio autorizado a chamar a API de outra origem.
# Vazio = só o próprio domínio da Vercel (recomendado).
ORIGEM_PERMITIDA=""
